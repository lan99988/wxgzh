# ============================================
# 公众号工作流 - 环境变量模板
# 复制为项目根目录的 aws.env 后填入真实值
# ============================================

# 微信公众号凭证（必填）
WECHAT_1_APPID=wx0000000000000000
WECHAT_1_APPSECRET=your_app_secret_here

# 写作模型 API Key（可选，Agent 代写时不需要）
WRITING_MODEL_API_KEY=

# 图片生成模型 API Key（可选，Agent 代生图时不需要）
IMAGE_MODEL_API_KEY=
